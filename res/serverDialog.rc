IDD_CREATESERVER DIALOGEX 0, 0, 357, 180
STYLE DS_CENTER | WS_POPUP | WS_SYSMENU | WS_CAPTION | WS_MINIMIZEBOX | WS_BORDER | DS_SETFONT
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Snake Server - Create game"
FONT 9, "Segoe UI"
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL
BEGIN

    CONTROL "Server options", -1, "Button", BS_GROUPBOX, 12, 6, 135, 55

    CONTROL "Port:", -1, "Static", SS_LEFT, 24, 20, 50, 9
    CONTROL "29349", 101, "Edit", WS_TABSTOP | ES_NUMBER, 106, 20, 28, 12, WS_EX_CLIENTEDGE

    CONTROL "Show server in &LAN searches", 104, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_DISABLED, 24, 40, 110, 9


    CONTROL "Security", -1, "Button", BS_GROUPBOX, 12, 67, 135, 60
    CONTROL "Request &password", 109, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 81, 70, 9


    CONTROL "Game options", -1, "Button", BS_GROUPBOX, 159, 6, 186, 140

    CONTROL "Name:", -1, "Static", 0, 171, 20, 40, 9
    CONTROL "Snake Game Server", 103, "Edit", SS_RIGHT | WS_TABSTOP | WS_GROUP | ES_AUTOHSCROLL, 223, 20, 110, 12, WS_EX_CLIENTEDGE

    CONTROL "Maximum players:", -1, "Static", SS_LEFT, 171, 40, 80, 9
    CONTROL "", -1, "Edit", ES_NUMBER | ES_RIGHT | WS_TABSTOP | WS_GROUP, 303, 40, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 102, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0

    CONTROL "Grid width:", -1, "Static", SS_LEFT, 171, 60, 50, 9
    CONTROL "", -1, "Edit", SS_RIGHT | WS_TABSTOP, 303, 60, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 106, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0

    CONTROL "Grid height:", -1, "Static", SS_LEFT, 171, 80, 50, 9
    CONTROL "", -1, "Edit", SS_RIGHT | WS_TABSTOP, 303, 80, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 107, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0

    CONTROL "&Eating increases players lenght", 105, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 171, 100, 112, 9

    //CONTROL "Players respawn", 106, "Button", BS_AUTOCHECKBOX, 171, 120, 60, 9

    CONTROL "Initial player lenght:", -1, "Static", SS_LEFT, 171, 120, 100, 9
    CONTROL "", -1, "Edit", SS_RIGHT | WS_TABSTOP, 303, 120, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 108, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0



    CONTROL "Secret options >:)", 600, "Button", BS_GROUPBOX, 12, 122, 135, 50

    CONTROL "TPS:", 601, "Static", SS_LEFT, 24, 138, 40, 9
    CONTROL "", 501, "Edit", SS_RIGHT, 100, 138, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 502, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0


    CONTROL "&OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_GROUP, 243, 161, 48, 13
    CONTROL "&Cancel", IDCANCEL, "Button", BS_PUSHBUTTON, 297, 161, 48, 13

END

IDD_CREATESERVER DIALOGEX 0, 0, 357, 180
