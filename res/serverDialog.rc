    CONTROL "Opciones secretas >:)", 600, "Button", BS_GROUPBOX, 12, 122, 135, 50

    CONTROL "TPS:", 601, "Static", SS_LEFT, 24, 138, 40, 9
    CONTROL "", 501, "Edit", SS_RIGHT, 100, 138, 30, 12, WS_EX_CLIENTEDGE
    CONTROL "", 502, "msctls_updown32", UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0


    CONTROL "&Aceptar", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_GROUP, 243, 161, 48, 13
