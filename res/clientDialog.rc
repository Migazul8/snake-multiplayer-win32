IDD_SERVERSELECT DIALOGEX 0, 0, 400, 110
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_SYSMENU | WS_CAPTION | WS_MINIMIZEBOX
CAPTION "Snake - Join game"
#ifdef BUILD_XP
FONT 8, "MS Shell Dlg"
#else
FONT 9, "Segoe UI"
#endif // BUILD_XP
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL
BEGIN

    CONTROL "Join manually", -1, "Button", BS_GROUPBOX, 12, 12, 154, 85

    CONTROL "IPv4 address:", -1, "Static", SS_LEFT, 24, 30, 80, 9
    CONTROL "", 111, "SysIPAddress32", WS_TABSTOP, 80, 29, 74, 11

    CONTROL "Port:", -1, "Static", SS_LEFT, 24, 50, 25, 9
    CONTROL "29349", 112, "Edit", SS_LEFT | WS_TABSTOP, 80, 49, 27, 12, WS_EX_CLIENTEDGE

    CONTROL "&Connect", 120, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 67, 72, 46, 14

    CONTROL "LAN games:", -1, "Static", SS_LEFT, 178, 12, 100, 9

    CONTROL "", 110, "SysListView32", LVS_REPORT | WS_VSCROLL | LVS_OWNERDATA | LVS_SINGLESEL | WS_TABSTOP, 178, 24, 210, 73, WS_EX_CLIENTEDGE

    //CONTROL "&Editar controles", 121, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_DISABLED, 338, 2, 60, 14

END

IDD_SERVERCONNECT DIALOGEX 0, 0, 200, 199
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Snake - Join to game"
#ifdef BUILD_XP
FONT 8, "MS Shell Dlg"
#else
FONT 9, "Segoe UI"
#endif // BUILD_XP
BEGIN

    CONTROL "Server info", -1, "Button", BS_GROUPBOX, 12, 12, 176, 74
    CONTROL "Connecting...", 130, "Static", SS_LEFT, 10, 184, 60, 9

    CONTROL "Game name:", 201, "Static", SS_LEFT | WS_DISABLED, 24, 30, 70, 9
    CONTROL "-", 101, "Edit", ES_RIGHT | ES_READONLY | ES_AUTOHSCROLL | WS_DISABLED, 100, 30, 74, 9

    CONTROL "Max players:", 202, "Static", SS_LEFT | WS_DISABLED, 24, 48, 100, 9
    CONTROL "-", 103, "Edit", ES_RIGHT | ES_READONLY | WS_DISABLED, 154, 48, 20, 9

    CONTROL "Jugadores conectados:", 204, "Static", SS_LEFT | WS_DISABLED, 24, 66, 100 9
    CONTROL "-", 104, "Edit", ES_RIGHT | ES_READONLY | WS_DISABLED, 154, 66, 20, 9


    CONTROL "You", -1, "Button", BS_GROUPBOX, 12, 92, 176, 83
    CONTROL "Name:", 203, "Static", SS_LEFT | WS_DISABLED, 24, 104, 60, 9
    CONTROL "", 102, "Edit", ES_LEFT | ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP, 76, 104, 100, 13, WS_EX_CLIENTEDGE

    CONTROL "Color:", 205, "Static", SS_LEFT | WS_DISABLED, 24, 128, 50, 9
    CONTROL "", 105, "ComboBox", CBS_DROPDOWNLIST | WS_DISABLED | WS_TABSTOP, 116, 128, 60, 60

    CONTROL "&Join", IDOK, "Button", BS_DEFPUSHBUTTON | WS_DISABLED | WS_TABSTOP | WS_GROUP, 91, 179, 46, 13
    CONTROL "&Cancel", IDCANCEL, "Button", BS_PUSHBUTTON, 142, 179, 46, 13

END

3 DIALOGEX 0, 0, 300, 100
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_SYSMENU | WS_MINIMIZEBOX | WS_CAPTION
CAPTION "Snake - Esperando al anfitrión"
FONT 9, "Segoe UI"
BEGIN

    CONTROL "&Salir", IDCLOSE, "Button", BS_PUSHBUTTON | WS_TABSTOP, 127, 50, 46, 13

    CONTROL "", 201, "Static", SS_LEFT, 12, 20, 276, 29

END
