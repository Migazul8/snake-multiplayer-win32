<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="snake-multiplayer-win32" />
		<Option pch_mode="2" />
		<Option compiler="msvc" />
		<Build>
			<Target title="Client Release">
				<Option output="bin/Snake" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Client" />
				<Option type="0" />
				<Option compiler="msvc" />
				<Compiler>
					<Add option="/Ox" />
				</Compiler>
				<Linker>
					<Add option="/SUBSYSTEM:WINDOWS,6.0" />
					<Add option="/entry:clientMain" />
				</Linker>
			</Target>
			<Target title="Server Release">
				<Option output="bin/SnakeServer" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Server/" />
				<Option type="0" />
				<Option compiler="msvc" />
				<Compiler>
					<Add option="/Ox" />
					<Add option="/DBUILD_SERVER" />
				</Compiler>
				<ResourceCompiler>
					<Add option="/DBUILD_SERVER" />
				</ResourceCompiler>
				<Linker>
					<Add option="/SUBSYSTEM:WINDOWS,6.0" />
					<Add option="/entry:serverMain" />
				</Linker>
			</Target>
			<Target title="Client Release XP">
				<Option output="bin/XP/Snake" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/XP/Client" />
				<Option type="0" />
				<Option compiler="msvc" />
				<Compiler>
					<Add option="/Ox" />
					<Add option="/DBUILD_XP" />
				</Compiler>
				<ResourceCompiler>
					<Add option="/DBUILD_XP" />
				</ResourceCompiler>
				<Linker>
					<Add option="/SUBSYSTEM:WINDOWS,5.2" />
					<Add option="/entry:clientMain" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="/GS-" />
			<Add directory="src" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="res" />
			<Add directory="src" />
		</ResourceCompiler>
		<Linker>
			<Add library="kernel32" />
			<Add library="gdi32" />
			<Add library="user32" />
			<Add library="Ws2_32" />
			<Add library="uxtheme" />
			<Add library="comctl32" />
			<Add library="ucrt" />
			<Add library="shlwapi" />
			<Add library="ole32" />
		</Linker>
		<Unit filename="res/clientDialog.rc">
